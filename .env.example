# ---------------------------------------------------------------------------
# FJ GLOW — environment variables (copy to .env.local, never commit real values)
# ---------------------------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put the Supabase service role key or any private API secret here:
# those belong to Supabase Edge Function secrets (configured in Phase 05).

# Public site URL, used for canonical links, Open Graph and the sitemap.
VITE_SITE_URL=

# Supabase project (Project Settings > API). The anon/publishable key is
# designed to be public; data is protected by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
